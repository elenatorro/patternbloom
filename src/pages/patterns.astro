---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import DownloadIcon from '@/components/ui/icons/download.astro';

// Filter patterns entries with 'draft: false' & date before current date
const publishedPatternsEntries = await getCollection("patterns", ({ data }) => {
  return !data.draft
});

// Sort content entries by publication date
publishedPatternsEntries.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});
---

<Layout title="Patterns">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Printable Patterns</Fragment>
      <Fragment slot="desc">
        Download free patterns for coloring
      </Fragment>
    </Sectionhead>
    <main class="mt-16">
      <ul class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {
          publishedPatternsEntries.map((patternsPostEntry, index) => (
            <li>
              <a href={`/patterns/${patternsPostEntry.slug}`} class="group block bg-white hover:bg-gray-50 transition-colors">
                <div class="relative">
                  <Picture
                    src={patternsPostEntry.data.image.src}
                    alt={patternsPostEntry.data.image.alt}
                    sizes="(max-width: 800px) 100vw, 400px"
                    width={400}
                    height={400}
                    loading={index <= 3 ? "eager" : "lazy"}
                    decoding={index <= 3 ? "sync" : "async"}
                    class="w-full aspect-square object-cover object-center bg-white"
                  />
                  <div class="absolute top-3 right-3 bg-[var(--color-sunny)] p-2">
                    <DownloadIcon />
                  </div>
                </div>
                <div class="p-4">
                  <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-coral)]">
                    {patternsPostEntry.data.category}
                  </span>
                  <h2 class="font-display text-lg font-bold leading-snug tracking-tight mt-1 text-[var(--color-ink)] group-hover:text-[var(--color-coral)] transition-colors">
                    {patternsPostEntry.data.title}
                  </h2>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </Container>
</Layout>

<style>
.pattern-preview-img {
  position: relative;
}
.pattern-download-icon {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: rgba(255,255,255,0.7);
  border-radius: 50%;
  padding: 0.25rem;
  box-shadow: 0 2px 8px rgba(120, 80, 180, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.grid.md\:grid-cols-2 {
  position: relative;
}
.visually-hidden {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
  display: none !important;
}
</style>
