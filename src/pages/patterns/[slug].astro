---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { Picture } from "astro:assets";
import Container from "@/components/container.astro";
import ImageDownload from '@/components/ui/ImageDownload.astro';

// Generate a new path for every collection entry
export async function getStaticPaths() {
  const patternsEntries = await getCollection("patterns");
  return patternsEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get the entry directly from the prop on render
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title}>
  <Container>
    <div class="mx-auto max-w-3xl mt-14 bg-white/90 p-8 md:p-12">
      <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-coral)]">
        {entry.data.category}
      </span>
      <h1
        class="font-display text-4xl lg:text-5xl font-extrabold lg:tracking-tight mt-2 lg:leading-tight text-[var(--color-ink)]">
        {entry.data.title}
      </h1>
      <div class="flex gap-3 mt-4 items-center flex-wrap md:flex-nowrap border-b border-gray-200 pb-4">
        <span class="text-[var(--color-ink)]/60 text-sm">
          {entry.data.author}
        </span>
        <div class="w-full md:w-auto flex flex-wrap gap-2">
          {
            entry.data.tags.map((tag) => (
              <span class="bg-[var(--color-sunny)] text-[var(--color-ink)] px-2 py-0.5 text-xs font-semibold">#{tag}</span>
            ))
          }
        </div>
      </div>

      <div class="prose prose-lg mt-8 max-w-3xl">
        <Picture
          src={entry.data.image.src}
          alt={entry.data.image.alt}
          sizes="(max-width: 800px) 100vw, 800px"
          width={800}
          height={600}
          loading="lazy"
          decoding="async"
          class="w-full rounded-md object-cover object-center bg-white visually-hidden"
          style="display:none;"
        />
        <Content />
      </div>
      <div class="text-center mt-12">
        <a
          href="/patterns"
          class="inline-block text-sm font-semibold uppercase tracking-widest text-[var(--color-ink)] border-b-2 border-[var(--color-coral)] pb-1 hover:text-[var(--color-coral)] transition-colors"
          >&larr; Back to Patterns</a
        >
      </div>
    </div>
  </Container>
</Layout>

<style>
.visually-hidden {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
  display: none !important;
}
</style>
