---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

const publishedPosts = await getCollection("blog", ({ data }) => {
  return !data.draft;
});

publishedPosts.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});
---

<Layout title="Blog">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Blog</Fragment>
      <Fragment slot="desc">
        Thoughts on procedural art, creative coding, and generative design
      </Fragment>
    </Sectionhead>

    <main class="mt-16">
      {publishedPosts.length === 0 && (
        <p class="text-center text-base text-[var(--color-ink)]/60">
          No posts yet. Stay tuned.
        </p>
      )}
      <ul class="grid gap-10 max-w-3xl mx-auto">
        {
          publishedPosts.map((post) => (
            <li>
              <a href={`/blog/${post.slug}`} class="group block border-l-4 border-[var(--color-lavender)] pl-6 bg-white/90 p-6 hover:border-[var(--color-coral)] transition-colors">
                <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-coral)]">
                  {post.data.category}
                </span>
                <h2 class="font-display text-2xl font-bold leading-snug tracking-tight mt-1 text-[var(--color-ink)] group-hover:text-[var(--color-coral)] transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-[var(--color-ink)]/70 text-sm mt-2">{post.data.snippet}</p>
                <time
                  class="text-[var(--color-ink)]/60 text-xs mt-2 block"
                  datetime={post.data.publishDate.toISOString()}>
                  {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </Container>
</Layout>
