---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

const publishedPosts = await getCollection("blog", ({ data }) => {
  return !data.draft;
});

publishedPosts.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});
---

<Layout title="Blog">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Blog</Fragment>
      <Fragment slot="desc">
        Thoughts on procedural art, creative coding, and generative design
      </Fragment>
    </Sectionhead>

    <main class="mt-16">
      {publishedPosts.length === 0 && (
        <p class="text-center text-lg text-slate-500">
          No posts yet. Stay tuned.
        </p>
      )}
      <ul class="grid gap-16 max-w-4xl mx-auto">
        {
          publishedPosts.map((post) => (
            <li>
              <a href={`/blog/${post.slug}`}>
                <div class="grid md:grid-cols-2 gap-5 md:gap-10 items-center">
                  {post.data.image && (
                    <div>
                      <img
                        src={post.data.image.src}
                        alt={post.data.image.alt}
                        class="w-full rounded-md object-cover object-center bg-white"
                        loading="lazy"
                      />
                    </div>
                  )}
                  <div>
                    <span class="text-blue-400 uppercase tracking-wider text-sm font-medium">
                      {post.data.category}
                    </span>
                    <h2 class="text-3xl font-semibold leading-snug tracking-tight mt-1">
                      {post.data.title}
                    </h2>
                    <p class="text-slate-500 mt-2">{post.data.snippet}</p>
                    <div class="flex gap-2 mt-3">
                      <time
                        class="text-gray-400"
                        datetime={post.data.publishDate.toISOString()}>
                        {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                      </time>
                    </div>
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </Container>
</Layout>
