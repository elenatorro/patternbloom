---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Portfolio">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Portfolio</Fragment>
      <Fragment slot="desc">
        Projects exploring procedural and generative art
      </Fragment>
    </Sectionhead>

    <main class="mt-16 grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      <a
        href="https://fooorma.com"
        target="_blank"
        rel="noopener"
        class="group block border-l-4 border-[var(--color-coral)] bg-white p-6 hover:bg-gray-50 transition-colors">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-[var(--color-coral)] flex items-center justify-center">
            <Icon class="w-5 h-5 text-white" name="bx:bx-code-alt" />
          </div>
          <h2 class="font-display text-xl font-bold text-[var(--color-ink)]">
            fooorma.com
          </h2>
        </div>
        <p class="text-[var(--color-ink)]/90 text-sm leading-relaxed">
          An open-source tool for creating procedural art. Design, tweak, and export generative patterns with an intuitive interface.
        </p>
        <span class="inline-block mt-4 text-sm text-[var(--color-coral)] font-semibold uppercase tracking-wider">
          Visit &rarr;
        </span>
      </a>

      <a
        href="/patterns"
        class="group block border-l-4 border-[var(--color-sunny)] bg-white p-6 hover:bg-gray-50 transition-colors">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-[var(--color-sunny)] flex items-center justify-center">
            <Icon class="w-5 h-5 text-[var(--color-ink)]" name="bx:bx-grid-alt" />
          </div>
          <h2 class="font-display text-xl font-bold text-[var(--color-ink)]">
            Print Patterns
          </h2>
        </div>
        <p class="text-[var(--color-ink)]/90 text-sm leading-relaxed">
          A collection of procedurally generated patterns, ready to download and print. Created with p5.js and custom algorithms.
        </p>
        <span class="inline-block mt-4 text-sm text-[var(--color-ink)] font-semibold uppercase tracking-wider">
          Browse &rarr;
        </span>
      </a>

      <a
        href="/portfolio/gallery"
        class="group block border-l-4 border-[var(--color-lavender)] bg-white p-6 hover:bg-gray-50 transition-colors">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-[var(--color-lavender)] flex items-center justify-center">
            <Icon class="w-5 h-5 text-[var(--color-ink)]" name="bx:bx-image" />
          </div>
          <h2 class="font-display text-xl font-bold text-[var(--color-ink)]">
            Art Gallery
          </h2>
        </div>
        <p class="text-[var(--color-ink)]/90 text-sm leading-relaxed">
          A curated selection of artistic images generated through procedural techniques. Exploring color, form, and algorithmic beauty.
        </p>
        <span class="inline-block mt-4 text-sm text-[var(--color-ink)] font-semibold uppercase tracking-wider">
          View &rarr;
        </span>
      </a>
    </main>
  </Container>
</Layout>
