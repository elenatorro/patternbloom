---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Portfolio">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Portfolio</Fragment>
      <Fragment slot="desc">
        Projects exploring procedural and generative art
      </Fragment>
    </Sectionhead>

    <main class="mt-16 grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      <a
        href="https://fooorma.com"
        target="_blank"
        rel="noopener"
        class="group block rounded-lg border border-gray-200 p-6 hover:shadow-lg transition">
        <div class="flex items-center gap-2 mb-4">
          <Icon class="w-6 h-6 text-slate-700" name="bx:bx-code-alt" />
          <h2 class="text-xl font-semibold text-gray-800 group-hover:text-indigo-600 transition">
            fooorma.com
          </h2>
        </div>
        <p class="text-slate-500">
          An open-source tool for creating procedural art. Design, tweak, and export generative patterns with an intuitive interface.
        </p>
        <span class="inline-block mt-4 text-sm text-indigo-600 font-medium">
          Visit fooorma.com &rarr;
        </span>
      </a>

      <a
        href="/patterns"
        class="group block rounded-lg border border-gray-200 p-6 hover:shadow-lg transition">
        <div class="flex items-center gap-2 mb-4">
          <Icon class="w-6 h-6 text-slate-700" name="bx:bx-grid-alt" />
          <h2 class="text-xl font-semibold text-gray-800 group-hover:text-indigo-600 transition">
            Ready-to-Print Patterns
          </h2>
        </div>
        <p class="text-slate-500">
          A collection of procedurally generated patterns, ready to download and print. Created with p5.js and custom algorithms.
        </p>
        <span class="inline-block mt-4 text-sm text-indigo-600 font-medium">
          Browse patterns &rarr;
        </span>
      </a>

      <a
        href="/portfolio/gallery"
        class="group block rounded-lg border border-gray-200 p-6 hover:shadow-lg transition">
        <div class="flex items-center gap-2 mb-4">
          <Icon class="w-6 h-6 text-slate-700" name="bx:bx-image" />
          <h2 class="text-xl font-semibold text-gray-800 group-hover:text-indigo-600 transition">
            Artistic Gallery
          </h2>
        </div>
        <p class="text-slate-500">
          A curated selection of artistic images generated through procedural techniques. Exploring color, form, and algorithmic beauty.
        </p>
        <span class="inline-block mt-4 text-sm text-indigo-600 font-medium">
          View gallery &rarr;
        </span>
      </a>
    </main>
  </Container>
</Layout>
