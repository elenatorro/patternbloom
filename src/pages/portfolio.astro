---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Portfolio">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Portfolio</Fragment>
      <Fragment slot="desc">
        Projects exploring procedural and generative art
      </Fragment>
    </Sectionhead>

    <main class="mt-16 grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      <a
        href="https://fooorma.com"
        target="_blank"
        rel="noopener"
        class="group block bg-[var(--color-sunny)] border-3 border-black p-6 shadow-[4px_4px_0px_#000] hover:shadow-[2px_2px_0px_#000] hover:translate-x-[2px] hover:translate-y-[2px] transition-all duration-150">
        <div class="flex items-center gap-2 mb-4">
          <Icon class="w-6 h-6 text-black" name="bx:bx-code-alt" />
          <h2 class="text-xl font-black text-black">
            fooorma.com
          </h2>
        </div>
        <p class="text-black">
          An open-source tool for creating procedural art. Design, tweak, and export generative patterns with an intuitive interface.
        </p>
        <span class="inline-block mt-4 text-sm text-black font-black underline">
          Visit fooorma.com &rarr;
        </span>
      </a>

      <a
        href="/patterns"
        class="group block bg-[var(--color-coral)] border-3 border-black p-6 shadow-[4px_4px_0px_#000] hover:shadow-[2px_2px_0px_#000] hover:translate-x-[2px] hover:translate-y-[2px] transition-all duration-150">
        <div class="flex items-center gap-2 mb-4">
          <Icon class="w-6 h-6 text-black" name="bx:bx-grid-alt" />
          <h2 class="text-xl font-black text-black">
            Ready-to-Print Patterns
          </h2>
        </div>
        <p class="text-black">
          A collection of procedurally generated patterns, ready to download and print. Created with p5.js and custom algorithms.
        </p>
        <span class="inline-block mt-4 text-sm text-black font-black underline">
          Browse patterns &rarr;
        </span>
      </a>

      <a
        href="/portfolio/gallery"
        class="group block bg-[var(--color-sky)] border-3 border-black p-6 shadow-[4px_4px_0px_#000] hover:shadow-[2px_2px_0px_#000] hover:translate-x-[2px] hover:translate-y-[2px] transition-all duration-150">
        <div class="flex items-center gap-2 mb-4">
          <Icon class="w-6 h-6 text-black" name="bx:bx-image" />
          <h2 class="text-xl font-black text-black">
            Artistic Gallery
          </h2>
        </div>
        <p class="text-black">
          A curated selection of artistic images generated through procedural techniques. Exploring color, form, and algorithmic beauty.
        </p>
        <span class="inline-block mt-4 text-sm text-black font-black underline">
          View gallery &rarr;
        </span>
      </a>
    </main>
  </Container>
</Layout>
