---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
---

<Layout title="Artistic Gallery">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Artistic Gallery</Fragment>
      <Fragment slot="desc">
        Procedural images exploring color, form, and algorithmic beauty
      </Fragment>
    </Sectionhead>

    <div class="mt-16 max-w-4xl mx-auto text-center">
      <p class="text-lg text-slate-500">
        New images coming soon. Stay tuned.
      </p>
    </div>

    <!-- Future: grid of images -->
    <!-- <div class="mt-16 grid grid-cols-2 md:grid-cols-3 gap-4 max-w-5xl mx-auto">
      Images will go here
    </div> -->
  </Container>
</Layout>
