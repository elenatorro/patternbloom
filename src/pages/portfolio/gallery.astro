---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
---

<Layout title="Artistic Gallery">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Artistic Gallery</Fragment>
      <Fragment slot="desc">
        Procedural images exploring color, form, and algorithmic beauty
      </Fragment>
    </Sectionhead>

    <div class="mt-16 max-w-4xl mx-auto text-center">
      <div class="bg-[var(--color-lavender)] border-3 border-black p-12 shadow-[4px_4px_0px_#000]">
        <p class="text-lg text-black font-bold">
          New images coming soon. Stay tuned.
        </p>
      </div>
    </div>

    <!-- Future: grid of images -->
    <!-- <div class="mt-16 grid grid-cols-2 md:grid-cols-3 gap-4 max-w-5xl mx-auto">
      Images will go here
    </div> -->
  </Container>
</Layout>
