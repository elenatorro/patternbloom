---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
---

<Layout title="Artistic Gallery">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Artistic Gallery</Fragment>
      <Fragment slot="desc">
        Procedural images exploring color, form, and algorithmic beauty
      </Fragment>
    </Sectionhead>

    <div class="mt-16 max-w-3xl mx-auto text-center">
      <div class="border-l-4 border-[var(--color-lavender)] py-12 pl-8 text-left bg-white/90 p-8">
        <p class="text-base text-[var(--color-ink)]/60">
          New images coming soon. Stay tuned.
        </p>
      </div>
    </div>

    <!-- Future: grid of images -->
    <!-- <div class="mt-16 grid grid-cols-2 md:grid-cols-3 gap-4 max-w-5xl mx-auto">
      Images will go here
    </div> -->
  </Container>
</Layout>
