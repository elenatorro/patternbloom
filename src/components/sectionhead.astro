---
const { align = "center" } = Astro.props;
---

<div class:list={["mt-16 bg-white/90 py-8 px-6 mx-auto max-w-3xl", align === "center" && "text-center"]}>
  <h1 class="font-display text-4xl lg:text-5xl font-extrabold lg:tracking-tight text-[var(--color-ink)]">
    <slot name="title">Title</slot>
  </h1>
  <p class="text-base mt-3 text-[var(--color-ink)]/70 max-w-xl mx-auto">
    <slot name="desc">Some description goes here</slot>
  </p>
</div>
