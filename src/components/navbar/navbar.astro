---
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  {
    title: "Portfolio",
    path: "/portfolio",
  },
  {
    title: "Blog",
    path: "/blog",
  },
  {
    title: "About",
    path: "/about",
  },
];
---

<header class="flex flex-col lg:flex-row justify-between items-center py-5 px-5 bg-white/5 backdrop-blur-xs">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="text-lg group">
          <span class="font-display font-extrabold text-[var(--color-ink)] tracking-tight">Pattern</span><span class="font-display font-extrabold text-[var(--color-coral)] tracking-tight">Bloom</span>
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-[var(--color-ink)]" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-1">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-[var(--color-ink)] text-sm font-semibold uppercase tracking-widest hover:bg-[var(--color-sunny)] transition-colors px-2">
                      <span>{item.title}</span>
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
      </MenuItems>
    </Astronav>
  </header>
