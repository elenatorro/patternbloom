
---
const { src, alt, filename = "download.png" } = Astro.props;
---

<style>

.image-download-outer {
  display: flex;
  justify-content: center;
  margin: 2rem 0;
}
.image-download-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
  padding: 2rem;
  background: #fff;
}
.image-download-preview {
  width: 100%;
}
.image-download-btn {
  display: inline-block;
  padding: 0.65rem 2rem;
  font-size: 0.85rem;
  background: var(--color-coral);
  color: #fff;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border: 2px solid var(--color-coral);
  cursor: pointer;
  text-decoration: none;
  transition: all 0.2s;
}
.image-download-btn:hover {
  background: var(--color-ink);
  border-color: var(--color-ink);
}
</style>

<div class="image-download-outer">
  <div class="image-download-container">
    <img src={src} alt={alt} class="image-download-preview" />
    <a href={src} download={filename} class="image-download-btn">Download</a>
  </div>
</div>
