
---
const { src, alt, filename = "download.png" } = Astro.props;
---

<style>

.image-download-outer {
  display: flex;
  justify-content: center;
  margin: 2rem 0;
}
.image-download-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding: 2rem;
  background: #f9f6ff;
  box-shadow: 0 4px 16px rgba(120, 80, 180, 0.10);
}
.image-download-preview {
  width: 100%;
  box-shadow: 0 2px 8px rgba(120, 80, 180, 0.12);
}
.image-download-btn {
  display: inline-block;
  padding: 0.75rem 2rem;
  font-size: 1.1rem;
  background: linear-gradient(90deg, #a18aff 0%, #ffb6b9 100%);
  color: #fff;
  font-weight: 700;
  border: none;
  border-radius: 0.75rem;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.2s, transform 0.2s;
  box-shadow: 0 2px 8px rgba(120, 80, 180, 0.10);
}
.image-download-btn:hover {
  background: linear-gradient(90deg, #ffb6b9 0%, #a18aff 100%);
  transform: scale(1.05);
}
</style>

<div class="image-download-outer">
  <div class="image-download-container">
    <img src={src} alt={alt} class="image-download-preview" />
    <a href={src} download={filename} class="image-download-btn">Download</a>
  </div>
</div>
