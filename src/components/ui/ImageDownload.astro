
---
const { src, alt, filename = "download.png" } = Astro.props;
---

<style>

.image-download-outer {
  display: flex;
  justify-content: center;
  margin: 2rem 0;
}
.image-download-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding: 2rem;
  background: var(--color-cream);
  border: 3px solid #000;
  box-shadow: 4px 4px 0px #000;
}
.image-download-preview {
  width: 100%;
  border: 3px solid #000;
}
.image-download-btn {
  display: inline-block;
  padding: 0.75rem 2rem;
  font-size: 1.1rem;
  background: var(--color-coral);
  color: #000;
  font-weight: 900;
  border: 3px solid #000;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.15s;
  box-shadow: 4px 4px 0px #000;
}
.image-download-btn:hover {
  box-shadow: 2px 2px 0px #000;
  transform: translate(2px, 2px);
}
</style>

<div class="image-download-outer">
  <div class="image-download-container">
    <img src={src} alt={alt} class="image-download-preview" />
    <a href={src} download={filename} class="image-download-btn">Download</a>
  </div>
</div>
