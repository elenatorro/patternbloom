---
interface Props {
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted";
  class?: string;
  [x: string]: any;
}

const {
  size = "md",
  style = "primary",
  block,
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  md: "px-5 py-2.5",
  lg: "px-6 py-3",
};

const styles = {
  outline: "bg-transparent border-2 border-[var(--color-ink)] text-[var(--color-ink)] hover:bg-[var(--color-ink)] hover:text-white",
  primary:
    "bg-[var(--color-coral)] text-white border-2 border-[var(--color-coral)] hover:bg-[var(--color-ink)] hover:border-[var(--color-ink)]",
};
---

<button
  {...rest}
  class:list={[
    "text-center transition-all duration-200 font-semibold tracking-wide uppercase text-sm focus-visible:ring-2 ring-offset-2 ring-gray-200",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</button>
