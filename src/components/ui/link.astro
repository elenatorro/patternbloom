---
interface Props {
  href: string;
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted" | "muted";
  class?: string;
  [x: string]: any;
}

const {
  href,
  block,
  size = "lg",
  style = "primary",
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  lg: "px-5 py-2.5",
  md: "px-4 py-2",
};

const styles = {
  outline: "bg-transparent border-2 border-[var(--color-ink)] text-[var(--color-ink)] hover:bg-[var(--color-ink)] hover:text-white",
  primary: "bg-[var(--color-coral)] text-white border-2 border-[var(--color-coral)] hover:bg-[var(--color-ink)] hover:border-[var(--color-ink)]",
  inverted: "bg-white text-[var(--color-ink)] border-2 border-white hover:bg-gray-100",
  muted: "bg-gray-100 text-[var(--color-ink)] border-2 border-gray-100 hover:bg-gray-200",
};
---

<a
  href={href}
  {...rest}
  class:list={[
    "text-center transition-all duration-200 font-semibold tracking-wide uppercase text-sm focus-visible:ring-2 ring-offset-2 ring-gray-200",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</a>
