---
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<main
  class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24">
  <div>
    <h1
      class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">
      PatternBloom
    </h1>
    <p class="text-lg mt-4 text-slate-600 max-w-xl">
      Procedural art by Elena Torr&oacute;
    </p>
    <p class="text-xl mt-4 text-slate-500 max-w-xl">
      Exploring the intersection of code, mathematics, and visual art through generative and procedural techniques.
    </p>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <Link
        href="/portfolio"
        class="flex gap-1 items-center justify-center"
        rel="noopener">
        <Icon class="text-white w-5 h-5" name="bx:bxs-palette" />
        View Portfolio
      </Link>
      <Link
        size="lg"
        style="outline"
        rel="noopener"
        href="/blog"
        class="flex gap-1 items-center justify-center">
        <Icon class="text-black w-4 h-4" name="bx:bx-book-reader" />
        Read the Blog
      </Link>
    </div>
  </div>
</main>
