---
import { SEO } from "astro-seo";
import { getImage } from "astro:assets";
import mainImage from "@/assets/main.png";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";

export interface Props {
  title: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const resolvedImageWithDomain = new URL(
  "/flowers.png",
  Astro.site
).toString();

const { title } = Astro.props;

const makeTitle = title
  ? title + " | " + "PatternBloom"
  : "PatternBloom - Procedural Art by Elena Torró";

const bg = await getImage({ src: mainImage });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={makeTitle}
      description="PatternBloom: Procedural art by Elena Torró. Exploring the intersection of code, mathematics, and visual art."
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: `PatternBloom - Procedural Art by Elena Torró`,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "PatternBloom",
        },
      }}
    />
  </head>
  <body class="min-h-screen flex flex-col page-bg" style={`--bg-tile: url('${bg.src}');`}>
    <Navbar />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
    <style is:global>
      img {
        content-visibility: auto;
      }

      .page-bg {
        background-image: var(--bg-tile);
        background-repeat: unset;
        background-size: contain;
        background-attachment: fixed;
      }

      .page-bg::before {
        content: '';
        position: fixed;
        inset: 0;
        background: var(--color-bg);
        opacity: 0.85;
        z-index: 0;
        pointer-events: none;
      }

      .page-bg > * {
        position: relative;
        z-index: 1;
      }

      .page-bg > header,
      .page-bg > footer {
        z-index: 2;
      }
    </style>
  </body>
</html>
