---
import Container from "@/components/container.astro";
// import { getFormattedDate } from "@/utils/all";
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
console.log(frontmatter);
---

<Layout title={frontmatter.title}>
  <Container>
    <div class="mx-auto max-w-[735px] mt-14">
      <span class="bg-[var(--color-sky)] text-black border-2 border-black px-2 py-0.5 text-xs font-black uppercase tracking-wider">
        {frontmatter.category}
      </span>
      <h1
        class="text-4xl lg:text-5xl font-black lg:tracking-tight mt-3 lg:leading-tight text-black">
        {frontmatter.title}
      </h1>

      <div class="flex gap-2 mt-3 items-center flex-wrap md:flex-nowrap">
        <span class="text-black font-medium">
          {frontmatter.author}
        </span>
        <div class="w-full md:w-auto flex flex-wrap gap-2">
          {
            frontmatter.tags.map((tag) => (
              <span class="bg-[var(--color-sunny)] text-black border-2 border-black px-2 py-0.5 text-xs font-bold">#{tag}</span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mx-auto prose prose-lg mt-6">
      <slot />
    </div>
    <div class="text-center mt-8">
      <a
        href="/patterns"
        class="bg-white border-3 border-black px-5 py-3 font-bold shadow-[4px_4px_0px_#000] hover:shadow-[2px_2px_0px_#000] hover:translate-x-[2px] hover:translate-y-[2px] transition-all duration-150 inline-block"
        >&larr; Back to Patterns</a
      >
    </div>
  </Container>
</Layout>
