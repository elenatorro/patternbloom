---
import Container from "@/components/container.astro";
// import { getFormattedDate } from "@/utils/all";
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
console.log(frontmatter);
---

<Layout title={frontmatter.title}>
  <Container>
    <div class="mx-auto max-w-[735px] mt-14 bg-white/90 p-8 md:p-12">
      <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-coral)]">
        {frontmatter.category}
      </span>
      <h1
        class="font-display text-4xl lg:text-5xl font-extrabold lg:tracking-tight mt-2 lg:leading-tight text-[var(--color-ink)]">
        {frontmatter.title}
      </h1>

      <div class="flex gap-3 mt-4 items-center flex-wrap md:flex-nowrap border-b border-gray-200 pb-4">
        <span class="text-[var(--color-ink)]/60 text-sm">
          {frontmatter.author}
        </span>
        <div class="w-full md:w-auto flex flex-wrap gap-2">
          {
            frontmatter.tags.map((tag) => (
              <span class="bg-[var(--color-sunny)] text-[var(--color-ink)] px-2 py-0.5 text-xs font-semibold">#{tag}</span>
            ))
          }
        </div>
      </div>

      <div class="prose prose-lg mt-8">
        <slot />
      </div>
      <div class="text-center mt-12">
        <a
          href="/patterns"
          class="inline-block text-sm font-semibold uppercase tracking-widest text-[var(--color-ink)] border-b-2 border-[var(--color-coral)] pb-1 hover:text-[var(--color-coral)] transition-colors"
          >&larr; Back to Patterns</a
        >
      </div>
    </div>
  </Container>
</Layout>
